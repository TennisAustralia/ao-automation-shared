{
  "name": "ao-automation-shared",
  "version": "0.1.3",
  "description": "Shared Node/TypeScript utilities and payload access for AO automation repositories.",
  "type": "module",
  "files": [
    "dist",
    "payloads",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tournament": {
      "types": "./dist/tournament/index.d.ts",
      "import": "./dist/tournament/index.js",
      "require": "./dist/tournament/index.js",
      "default": "./dist/tournament/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js",
      "require": "./dist/env/index.js",
      "default": "./dist/env/index.js"
    },
    "./mail": {
      "types": "./dist/mail/index.d.ts",
      "import": "./dist/mail/index.js",
      "require": "./dist/mail/index.js",
      "default": "./dist/mail/index.js"
    },
    "./random": {
      "types": "./dist/random/index.d.ts",
      "import": "./dist/random/index.js",
      "require": "./dist/random/index.js",
      "default": "./dist/random/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:compat:cjs": "npm run build && node scripts/smoke-cjs-tournament-require.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
